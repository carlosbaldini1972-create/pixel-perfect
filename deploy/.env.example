######################################################################
# VirtualWeb ERP - Self-Hosted environment
# Copy to .env and fill in all values before `docker compose up -d`
######################################################################

############ Postgres ############
POSTGRES_PASSWORD=change-me-strong-random
POSTGRES_DB=postgres
POSTGRES_PORT=5432

############ Supabase Auth / API ############
# Generate with: openssl rand -hex 64  (must be >= 32 chars)
JWT_SECRET=change-me-jwt-secret-min-32-chars
JWT_EXPIRY=3600

# Generate ANON_KEY and SERVICE_ROLE_KEY signing them with JWT_SECRET.
# See: https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
ANON_KEY=eyJ...generate-me...
SERVICE_ROLE_KEY=eyJ...generate-me...

############ URLs ############
# Public URL the browser uses to reach Kong (Supabase API gateway).
# In LAN-only mode, point this to the VM IP, e.g. http://192.168.0.50:8000
API_EXTERNAL_URL=http://192.168.0.50:8000
# Public URL of the ERP app itself (used by GoTrue for email links etc).
SITE_URL=http://192.168.0.50

############ Auth behavior ############
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
# SMTP (optional, leave blank to disable email sending while in LAN-only mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=VirtualWeb ERP
SMTP_ADMIN_EMAIL=admin@virtualweb.local

############ Supabase Studio (admin UI) ############
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me

############ App (TanStack Start ERP) ############
APP_PORT=3000
# These two are what the BROWSER sees - must match API_EXTERNAL_URL / ANON_KEY
VITE_SUPABASE_URL=${API_EXTERNAL_URL}
VITE_SUPABASE_PUBLISHABLE_KEY=${ANON_KEY}
